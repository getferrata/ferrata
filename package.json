{
  "name": "ferrata",
  "version": "1.4.0",
  "description": "Turn your team's knowledge into a verified onboarding course.",
  "author": "sbr0nch",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://getferrata.github.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getferrata/ferrata.git"
  },
  "bugs": "https://github.com/getferrata/ferrata/issues",
  "packageManager": "pnpm@10.33.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:backup": "tsx src/db/backup.ts",
    "test:e2e": "playwright test",
    "db:seed:demo": "tsx src/db/seed-demo.ts",
    "audit:deps": "node scripts/audit-deps.mjs",
    "audit:invariants": "tsx scripts/check-invariants.ts",
    "preflight:row": "tsx scripts/preflight-row.ts",
    "db:probe": "tsx scripts/db-probe.ts",
    "course:context": "tsx scripts/course-context.ts",
    "course:dump": "tsx scripts/course-dump.ts"
  },
  "dependencies": {
    "@sbr0nch/contextia-engine": "^2.0.3",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "jsonrepair": "^3.15.0",
    "mammoth": "^1.9.0",
    "marked": "^15.0.6",
    "next": "15.5.22",
    "pdf-parse": "^1.1.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sanitize-html": "^2.14.0",
    "sharp": "0.35.3",
    "ts-fsrs": "^4.7.0",
    "undici": "^8.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/sanitize-html": "^2.13.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.9.0",
    "jszip": "^3.10.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.8"
  }
}
